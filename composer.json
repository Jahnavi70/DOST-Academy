{
  "name": "dost-academy/backend",
  "type": "project",
  "description": "DOST Academy LMS Backend",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "tymon/jwt-auth": "^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "phpunit/phpunit": "^10.0"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "audit": {
      "block-insecure": false
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
  }
}